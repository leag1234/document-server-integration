    <title><%= appName %></title>
    <% if (hasFavicon) { %><link rel="icon" href="elixir/brand/favicon.svg" type="image/svg+xml" /><% } %>
    <link rel="stylesheet" href="elixir/home.css" />
</head>
<%
  const types = ['word', 'cell', 'slide', 'pdf'];
  const blankExt = { word: 'docx', cell: 'xlsx', slide: 'pptx', pdf: 'pdf' };
  const langParam = '&lang=' + encodeURIComponent(lang.editor);
  const avatar = (cls) => account.image
    ? `<span class="avatar ${cls}" style="--av:${account.color}"><img src="${account.image}" alt="" /></span>`
    : `<span class="avatar ${cls}" style="--av:${account.color}" aria-hidden="true">${account.initials.replace(/[<>&"]/g, '')}</span>`;
  const cloudLabel = nc.connected ? (account.serverName || account.serverHost) : t('nav.cloud');
%>
<body>
    <a class="skip-link" href="#main"><%= t('skipToContent') %></a>
    <%- iconSprite %>
    <header class="topbar">
        <a class="brand" href="./" aria-label="<%= appName %> &ndash; <%= t('nav.home') %>">
            <% if (hasLogo) { %>
                <img src="elixir/brand/logo.svg" alt="<%= appName %>" width="135" height="26" />
            <% } else { %>
                <span class="brand-text"><%= appName %></span>
            <% } %>
        </a>
        <div class="search" role="search">
            <svg class="search-icon" aria-hidden="true"><use href="#i-search"/></svg>
            <input type="search" id="search" autocomplete="off" spellcheck="false"
                placeholder="<%= t('search.placeholder') %>" aria-label="<%= t('search.label') %>" />
            <kbd class="search-kbd" aria-hidden="true">/</kbd>
        </div>
        <div class="account">
            <button type="button" class="account-btn" id="account-btn" aria-haspopup="dialog" aria-expanded="false"
                aria-controls="account-panel" title="<%= account.name %>" aria-label="<%= t('account.menuLabel', { name: account.name }) %>">
                <%- avatar('') %>
            </button>
        </div>
    </header>

    <div class="layout">
        <nav class="rail" aria-label="<%= t('nav.label') %>">
            <a class="rail-item" href="#home" data-view="home">
                <svg class="ic ic-r" aria-hidden="true"><use href="#i-home"/></svg>
                <svg class="ic ic-f" aria-hidden="true"><use href="#i-home-f"/></svg>
                <span><%= t('nav.home') %></span>
            </a>
            <a class="rail-item" href="#new" data-view="new">
                <svg class="ic ic-r" aria-hidden="true"><use href="#i-add"/></svg>
                <svg class="ic ic-f" aria-hidden="true"><use href="#i-add-f"/></svg>
                <span><%= t('nav.new') %></span>
            </a>
            <a class="rail-item" href="#open" data-view="open">
                <svg class="ic ic-r" aria-hidden="true"><use href="#i-open"/></svg>
                <svg class="ic ic-f" aria-hidden="true"><use href="#i-open-f"/></svg>
                <span><%= t('nav.open') %></span>
            </a>
            <a class="rail-item" href="#cloud" data-view="cloud" title="<%= nc.connected ? account.server : t('nav.cloudTitle') %>">
                <svg class="ic ic-r" aria-hidden="true"><use href="#i-cloud"/></svg>
                <svg class="ic ic-f" aria-hidden="true"><use href="#i-cloud-f"/></svg>
                <span><%= cloudLabel %></span>
            </a>
            <% if (nc.connected) { %>
            <a class="rail-item" href="#local" data-view="local" title="<%= t('nav.localTitle') %>">
                <svg class="ic ic-r" aria-hidden="true"><use href="#i-laptop"/></svg>
                <svg class="ic ic-f" aria-hidden="true"><use href="#i-laptop-f"/></svg>
                <span><%= t('nav.local') %></span>
            </a>
            <% } %>
            <div class="rail-sep" role="separator"></div>
            <% types.forEach((type) => { %>
                <a class="rail-item rail-app" href="#<%= type %>" data-view="<%= type %>" data-type="<%= type %>">
                    <svg class="ic ic-r t-<%= type %>" aria-hidden="true"><use href="#i-<%= type %>"/></svg>
                    <svg class="ic ic-f t-<%= type %>" aria-hidden="true"><use href="#i-<%= type %>-f"/></svg>
                    <span><%= t('app.' + type) %></span>
                </a>
            <% }) %>
            <div class="rail-fill"></div>
            <% if (devMode) { %>
            <a class="rail-item rail-dev" href="?dev=1" title="<%= t('dev.title') %>">
                <svg class="ic" aria-hidden="true"><use href="#i-wrench"/></svg>
                <span><%= t('dev.label') %></span>
            </a>
            <% } %>
        </nav>

        <main id="main" tabindex="-1">
            <section class="connect-card" id="connect-card" aria-labelledby="connect-title" hidden>
                <svg class="connect-icon" aria-hidden="true"><use href="#i-cloud"/></svg>
                <div class="connect-text">
                    <h2 id="connect-title"><%= t('nc.card.title') %></h2>
                    <p><%= t('nc.card.body') %></p>
                </div>
                <button type="button" class="btn btn-primary" data-connect="1"><%= t('nc.connect') %></button>
                <button type="button" class="icon-btn" id="connect-dismiss" aria-label="<%= t('nc.card.dismiss') %>" title="<%= t('nc.card.dismiss') %>">
                    <svg class="ic-sm" aria-hidden="true"><use href="#i-dismiss"/></svg>
                </button>
            </section>
            <div class="loc-pick" id="loc-pick" role="radiogroup" aria-label="<%= t('loc.label') %>" hidden>
                <span class="loc-label"><%= t('loc.label') %></span>
                <button type="button" class="loc-opt" role="radio" data-loc="nc" aria-checked="true"><%= cloudLabel %></button>
                <button type="button" class="loc-opt" role="radio" data-loc="local" aria-checked="false"><%= t('loc.server') %></button>
            </div>
            <section class="start" id="start" aria-labelledby="start-title">
                <h1 class="section-title" id="start-title"><%= t('home.startNew') %></h1>
                <div class="tiles" id="tiles">
                    <% types.forEach((type) => { %>
                        <a class="tile tile-blank" data-type="<%= type %>" data-blank="1" target="_blank"
                            href="editor?fileExt=<%= blankExt[type] %><%= langParam %>">
                            <span class="thumb thumb-<%= type %>" aria-hidden="true"><span class="sheet"></span></span>
                            <span class="tile-label"><%= t('tile.blank.' + type) %></span>
                        </a>
                    <% }) %>
                    <% templates.forEach((tpl) => { %>
                        <a class="tile tile-template" data-type="<%= tpl.documentType %>" target="_blank"
                            href="elixir/new?template=<%= encodeURIComponent(tpl.id) %><%= langParam %>">
                            <span class="thumb thumb-image" aria-hidden="true">
                                <% if (tpl.thumb) { %><img src="<%= tpl.thumb %>" alt="" loading="lazy" decoding="async" /><% } %>
                                <svg class="thumb-badge t-<%= tpl.documentType %>"><use href="#i-<%= tpl.documentType %>-f"/></svg>
                            </span>
                            <span class="tile-label"><%= tpl.title %></span>
                        </a>
                    <% }) %>
                </div>
            </section>

            <section class="open-panel" id="open-panel" aria-labelledby="open-title" hidden>
                <h1 class="section-title" id="open-title"><%= t('open.title') %></h1>
                <label class="dropzone" id="dropzone" for="file-input">
                    <svg class="dropzone-icon" aria-hidden="true"><use href="#i-upload"/></svg>
                    <span class="dropzone-title"><%= t('open.drop') %></span>
                    <span class="dropzone-or"><%= t('open.or') %></span>
                    <span class="btn btn-primary"><%= t('open.browse') %></span>
                    <span class="dropzone-hint"><%= t('open.hint') %></span>
                </label>
            </section>

            <section class="recent" id="recent" aria-labelledby="recent-title">
                <div class="recent-head">
                    <h2 class="section-title" id="recent-title"><%= t('recent.title') %></h2>
                    <nav class="crumbs" id="crumbs" aria-label="<%= t('nc.crumbs') %>" hidden></nav>
                    <div class="chips" id="chips" role="group" aria-label="<%= t('filter.label') %>">
                        <button type="button" class="chip" data-filter="" aria-pressed="true"><%= t('filter.all') %></button>
                        <% types.forEach((type) => { %>
                            <button type="button" class="chip" data-filter="<%= type %>" aria-pressed="false"><%= t('filter.' + type) %></button>
                        <% }) %>
                    </div>
                    <span class="recent-fill"></span>
                    <button type="button" class="btn btn-subtle" id="new-button" aria-haspopup="menu" hidden>
                        <svg class="ic-sm" aria-hidden="true"><use href="#i-add"/></svg>
                        <span><%= t('nc.newIn') %></span>
                    </button>
                    <label class="btn btn-subtle" id="upload-button" for="file-input">
                        <svg class="ic-sm" aria-hidden="true"><use href="#i-upload"/></svg>
                        <span><%= t('upload.button') %></span>
                    </label>
                </div>
                <table class="files" id="files">
                    <thead>
                        <tr>
                            <th class="c-icon" scope="col"><span class="visually-hidden"><%= t('col.name') %></span></th>
                            <th class="c-name" scope="col"><%= t('col.name') %></th>
                            <th class="c-mod" scope="col"><%= t('col.modified') %></th>
                            <th class="c-size" scope="col"><%= t('col.size') %></th>
                            <th class="c-act" scope="col"><span class="visually-hidden"><%= t('col.actions') %></span></th>
                        </tr>
                    </thead>
                    <tbody id="files-body"></tbody>
                </table>
                <div class="empty" id="empty" hidden>
                    <svg class="empty-icon" aria-hidden="true"><use href="#i-file"/></svg>
                    <p class="empty-title"><%= t('empty.title') %></p>
                    <p class="empty-body"><%= t('empty.body') %></p>
                </div>
                <p class="no-match" id="no-match" hidden></p>
            </section>
        </main>
    </div>

    <input type="file" id="file-input" class="visually-hidden" tabindex="-1"
        accept="<%= uploadExts.map((e) => '.' + e).join(',') %>" />

    <div class="menu" id="menu" role="menu" hidden>
        <button type="button" role="menuitem" data-action="open">
            <svg class="ic-sm" aria-hidden="true"><use href="#i-new-tab"/></svg><span><%= t('action.open') %></span>
        </button>
        <button type="button" role="menuitem" data-action="download">
            <svg class="ic-sm" aria-hidden="true"><use href="#i-download"/></svg><span><%= t('action.download') %></span>
        </button>
        <button type="button" role="menuitem" data-action="location" data-nc="1">
            <svg class="ic-sm" aria-hidden="true"><use href="#i-open"/></svg><span><%= t('nc.action.location') %></span>
        </button>
        <button type="button" role="menuitem" data-action="web" data-nc="1">
            <svg class="ic-sm" aria-hidden="true"><use href="#i-cloud"/></svg><span><%= t('nc.action.web', { server: account.serverHost || 'Nextcloud' }) %></span>
        </button>
        <div class="menu-sep" role="separator" data-local="1"></div>
        <button type="button" role="menuitem" data-action="delete" class="danger" data-local="1">
            <svg class="ic-sm" aria-hidden="true"><use href="#i-delete"/></svg><span><%= t('action.delete') %></span>
        </button>
    </div>

    <div class="menu" id="new-menu" role="menu" hidden>
        <% ['word', 'cell', 'slide'].forEach((type) => { %>
        <button type="button" role="menuitem" data-new="<%= blankExt[type] %>">
            <svg class="ic-sm t-<%= type %>" aria-hidden="true"><use href="#i-<%= type %>-f"/></svg><span><%= t('tile.blank.' + type) %></span>
        </button>
        <% }) %>
    </div>

    <div class="account-panel" id="account-panel" role="dialog" aria-label="<%= t('account.title') %>" hidden>
        <div class="acct-head">
            <%- avatar('avatar-lg') %>
            <div class="acct-id">
                <div class="acct-name" id="acct-name"><%= account.name %></div>
                <div class="acct-sub"><%= nc.connected ? (account.email || account.login || '') : t('account.localProfile') %></div>
                <% if (nc.connected) { %><div class="acct-sub acct-server"><svg class="ic-xs" aria-hidden="true"><use href="#i-cloud"/></svg><span><%= account.serverHost %></span></div><% } %>
            </div>
        </div>
        <div class="acct-actions">
            <% if (nc.connected) { %>
                <a class="acct-item" href="<%= account.server %>/index.php/settings/user/security" target="_blank" rel="noopener noreferrer">
                    <svg class="ic-sm" aria-hidden="true"><use href="#i-person"/></svg><span><%= t('account.manage', { server: account.serverHost }) %></span>
                </a>
                <button type="button" class="acct-item" id="acct-disconnect">
                    <svg class="ic-sm" aria-hidden="true"><use href="#i-sign-out"/></svg><span><%= t('nc.disconnect') %></span>
                </button>
            <% } else { %>
                <button type="button" class="acct-item" data-connect="1">
                    <svg class="ic-sm" aria-hidden="true"><use href="#i-link"/></svg><span><%= t('nc.connect') %></span>
                </button>
                <button type="button" class="acct-item" id="acct-rename">
                    <svg class="ic-sm" aria-hidden="true"><use href="#i-edit"/></svg><span><%= t('account.changeName') %></span>
                </button>
            <% } %>
            <div class="menu-sep" role="separator"></div>
            <button type="button" class="acct-item" id="acct-dev" role="switch" aria-checked="<%= devMode ? 'true' : 'false' %>">
                <svg class="ic-sm" aria-hidden="true"><use href="#i-wrench"/></svg><span><%= t('account.devMode') %></span>
                <span class="switch" aria-hidden="true"></span>
            </button>
            <% if (devMode) { %>
                <div class="acct-group" role="group" aria-label="<%= t('account.testUser') %>">
                    <div class="acct-group-title"><%= t('account.testUser') %></div>
                    <button type="button" class="acct-item acct-test" data-test-user="" aria-pressed="<%= account.devUser ? 'false' : 'true' %>">
                        <svg class="ic-sm" aria-hidden="true"><use href="#i-check"/></svg><span><%= t('account.testUserNone', { name: account.name }) %></span>
                    </button>
                    <% account.testUsers.forEach((u) => { %>
                    <button type="button" class="acct-item acct-test" data-test-user="<%= u.id %>" aria-pressed="<%= account.devUser === u.id ? 'true' : 'false' %>">
                        <svg class="ic-sm" aria-hidden="true"><use href="#i-check"/></svg><span><%= u.name %></span>
                    </button>
                    <% }) %>
                </div>
            <% } %>
        </div>
        <p class="acct-privacy"><svg class="ic-xs" aria-hidden="true"><use href="#i-lock"/></svg><span><%= t('account.privacy') %></span></p>
    </div>

    <dialog class="dialog" id="connect-dialog" aria-labelledby="connect-dialog-title">
        <form id="connect-form" novalidate>
            <h2 id="connect-dialog-title"><%= t('nc.dialog.title') %></h2>
            <div class="connect-step" id="connect-step-server">
                <p><%= t('nc.dialog.body') %></p>
                <label class="field-label" for="connect-server"><%= t('nc.dialog.server') %></label>
                <input class="field" type="url" id="connect-server" name="server" autocomplete="url" spellcheck="false"
                    value="<%= nc.defaultServer %>" placeholder="https://cloud.example.org" required />
                <p class="field-hint"><%= t('nc.dialog.hint') %></p>
                <p class="field-error" id="connect-error" role="alert" hidden></p>
                <div class="dialog-actions">
                    <button type="submit" class="btn btn-primary" id="connect-submit"><%= t('nc.dialog.continue') %></button>
                    <button type="button" class="btn" data-close="1"><%= t('action.cancel') %></button>
                </div>
            </div>
            <div class="connect-step" id="connect-step-wait" hidden>
                <p class="connect-wait"><span class="spinner" aria-hidden="true"></span><span id="connect-wait-text"></span></p>
                <p class="field-hint"><%= t('nc.dialog.waitHint') %> <a href="#" id="connect-reopen" target="_blank" rel="noopener"><%= t('nc.dialog.reopen') %></a></p>
                <div class="dialog-actions">
                    <button type="button" class="btn" data-close="1"><%= t('action.cancel') %></button>
                </div>
            </div>
        </form>
    </dialog>

    <dialog class="dialog" id="profile-dialog" aria-labelledby="profile-title">
        <form id="profile-form" method="dialog">
            <h2 id="profile-title"><%= t('profile.title') %></h2>
            <p><%= t('profile.body') %></p>
            <label class="field-label" for="profile-name"><%= t('profile.name') %></label>
            <input class="field" type="text" id="profile-name" maxlength="80" autocomplete="name"
                value="<%= account.named ? account.name : '' %>" placeholder="<%= t('profile.defaultName') %>" />
            <div class="dialog-actions">
                <button class="btn btn-primary" value="ok"><%= t('profile.save') %></button>
                <button class="btn" value="skip" id="profile-skip"><%= t('profile.skip') %></button>
            </div>
        </form>
    </dialog>

    <dialog class="dialog" id="confirm" aria-labelledby="confirm-title">
        <form method="dialog">
            <h2 id="confirm-title"><%= t('delete.title') %></h2>
            <p id="confirm-body"></p>
            <div class="dialog-actions">
                <button class="btn btn-danger" value="ok"><%= t('action.delete') %></button>
                <button class="btn" value="cancel" autofocus><%= t('action.cancel') %></button>
            </div>
        </form>
    </dialog>

    <div class="toast" id="toast" role="status" aria-live="polite" hidden>
        <span class="toast-spinner" aria-hidden="true"></span>
        <span class="toast-text" id="toast-text"></span>
        <a class="toast-link" id="toast-link" target="_blank" hidden></a>
        <button type="button" class="icon-btn toast-close" id="toast-close" aria-label="<%= t('toast.close') %>">
            <svg class="ic-sm" aria-hidden="true"><use href="#i-dismiss"/></svg>
        </button>
    </div>

    <div class="drop-overlay" id="drop-overlay" hidden>
        <div class="drop-overlay-box">
            <svg aria-hidden="true"><use href="#i-upload"/></svg>
            <span><%= t('upload.dropOverlay') %></span>
        </div>
    </div>

    <script id="home-data" type="application/json"><%- JSON.stringify({
        lang,
        strings,
        files,
        uploadExts,
        convertExts,
        maxFileSize,
        apiUrl,
        account,
        nc,
        devMode,
        csrf,
        askName: account.source === 'local' && !account.named && !account.asked,
        startTitles: {
            home: t('home.startNew'),
            new: t('new.title'),
            word: t('app.word.title'),
            cell: t('app.cell.title'),
            slide: t('app.slide.title'),
            pdf: t('app.pdf.title'),
        },
    }).replace(/</g, '\\u003c') %></script>
    <script src="elixir/home.js"></script>
</body>
</html>
